/v4/6b/4b/5d/6b4b5d2e-3b44-cb4a-3d25-b051378d843c/2-iPad.png/360x480bb.jpg","https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/60/76/db/6076dbcf-69c3-c177-44c4-13e887b12204/3-iPad.png/360x480bb.jpg","https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/67/32/fd/6732fd21-5754-76f4-2cf5-e05a8149c0d2/4-iPad.png/360x480bb.jpg","https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/19/cd/79/19cd7973-d444-cbed-db7d-4354b3276b97/5-iPad.png/360x480bb.jpg"],"appletvScreenshotUrls":[],"trackCensoredName":"Bluesky Social","trackViewUrl":"https://apps.apple.com/no/app/bluesky-social/id6444370199?uo=4","contentAdvisoryRating":"17+","averageUserRating":4.05042,"releaseNotes":"More ways to express yourself, support your favorite creators, and enjoy Bluesky on a bigger screen!\n\n- Profile Links: Add links to your website, newsletter, and more with prominent buttons at the top of your profile. Special green buttons let your followers support you through services like Patreon and Ko-fi.\n- iPad support: Bluesky is now optimized for iPad, with a new layout designed for larger screens.\n\nPlus, as always, a bunch of bug fixes and performance improvements.","artistId":1654243552,"artistName":"Bluesky PBLLC","price":0.0,"bundleId":"xyz.blueskyweb.app","minimumOsVersion":"16.4","releaseDate":"2023-02-18T08:00:00Z","isVppDeviceBasedLicensingEnabled":true,"trackId":6444370199,"trackName":"Bluesky Social","sellerName":"Bluesky PBLLC","currentVersionReleaseDate":"2026-10-22T16:03:25Z","version":"1.136.0","wrapperType":"software","currency":"NOK","description":"Bluesky is the social app built for better conversations. Find your people, follow what you care about, and have fun online again — without ads or engagement traps.\n\nJOIN THE MOMENT\n\nSee what people are talking about right now. From breaking news to big cultural moments, jump into conversations as they unfold and be part of what's happening.\n\nEXPLORE FEEDS\n\nChoose from thousands of community-built feeds covering news, art, pets, science, fandom, investing, culture, and everything in between. Stay updated with people you care about in your Following feed, or dive into new perspectives and trends in Discover.\n\nCONTROL YOUR SCROLL\n\nUse powerful moderation tools and content filters to shape exactly what you see. Hide what you don't want, follow what you do, and decide who can interact with you.\n\nJUMP RIGHT IN\n\nStarter Packs help you get going fast. Follow curated lists of interesting people with one tap and start building your community instantly.\n\nAVOID THE BILLIONAIRES\n\nThe internet is too important to be controlled by a handful of powerful people. Bluesky is building an open, community-driven foundation for the social internet. With one account, you can use the Bluesky app and take your identity anywhere on the growing ecosystem of apps built on the same protocol.","averageUserRatingForCurrentVersion":4.05042,"sellerUrl":"https://bsky.app","languageCodesISO2A":["AN","EU","KM","CA","CS","DA","NL","EN","EO","FI","FR","FY","GD","GL","DE","EL","HI","HU","ID","IA","GA","IT","JA","KO","NE","PL","PT","RO","RU","ZH","ES","SV","TH","ZH","TR","UK","VI","CY"],"fileSizeBytes":"101643264","formattedPrice":"Free","userRatingCountForCurrentVersion":119,"trackContentRating":"17+","primaryGenreName":"Social Networking","primaryGenreId":6005,"genreIds":["6005","6016"],"genres":["Social Networking","Entertainment"],"userRatingCount":119}