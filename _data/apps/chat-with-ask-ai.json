rls":[],"artworkUrl512":"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/04/60/02/046002b9-22d4-a8a1-60ff-cad3b1c337cc/AppIcon-0-0-1x_U007ephone-0-1-sRGB-85-220.png/512x512bb.jpg","releaseNotes":"We fixed some pesky bugs and improved the overall performance of the app.","minimumOsVersion":"15.5","price":0.0,"genres":["Productivity","Utilities"],"artistId":1833881740,"artistName":"DEEP FLOW SOFTWARE SERVICES","bundleId":"com.codeway.chatapp","isVppDeviceBasedLicensingEnabled":true,"releaseDate":"2023-03-07T08:00:00Z","primaryGenreName":"Productivity","primaryGenreId":6007,"sellerName":"DEEP FLOW SOFTWARE SERVICES - FZCO","trackId":1668787639,"trackName":"Chat AI: Ask Agent Anything","currentVersionReleaseDate":"2026-09-28T09:16:08Z","version":"3.6.3","wrapperType":"software","currency":"NOK","description":"Welcome to Chat AI, your everyday AI chat app and assistant.\nChat with an AI that picks up on your tone, keeps track of the conversation and gives you a straight answer instead of a wall of text.\n\nBuilt on GPT-6, Claude Opus 5, Gemini 3.1 Pro, Gemini 3.8 Flash, Grok 4.7, DeepSeek V4 Pro and Perplexity, Chat AI lets you pick the right model for any task without switching between apps. Trusted by over 50 million people worldwide.\n\nASK ANYTHING, ANYTIME:\nEver wondered what a chat with a historical figure or a business great would actually sound like? Chat AI makes it happen, straight from your phone. Ask for a recommendation, settle a debate down the pub, or pick up something new on the commute.\n\nAI ASSISTANTS FOR ANY TASK:\nNeed a hand from someone who knows the field? The app comes with a range of specialised AI assistants: copywriters, logo designers, business planners, fitness coaches and plenty more. Whatever you are working on, there is an assistant ready to go.\n\nIMAGE GENERATION AND EXPLORATION:\nBe Your Own Artist: Describe a scene or a place you have never been and let AI image generation turn it into a picture. Make book covers, social posts, party invitations and more.\nLearn About Your World Through Images: Take a photo of anything around you, a building, a piece of art or a landscape, and get instant info about it with image input.\n\nENHANCED TEXT GENERATOR FOR EASY WRITING HELP:\nThe AI writing assistant helps you get ideas down, put together an outline and write full paragraphs. Sort out any writing job with ease, from a CV and a covering letter to a blog post, a bedtime story or the email you have been putting off all week.\n\nSIMPLE WEB SEARCH:\nTell the AI what you are after, whether it is the latest tech, fashion or health tips, and get current info without trawling through pages of results.\n\nFUN LANGUAGE LEARNING AND HOMEWORK HELPER:\nLanguage Practice: Brush up on your French before a weekend away, or learn Japanese through a samurai adventure. AI turns language practice into something you look forward to.\nAcademic Support: Stuck on a question? Use Chat AI as a homework helper for everything from primary school maths to GCSE revision and A level essay plans.\n\nSMART SUMMARY ASSISTANT:\nQuick Summaries: Get the main points of a long video or a dense document in a few lines.\nAsk Questions: Upload a document, paste a link to an article or a video, then ask whatever you are curious about and get an answer straight away.\n\nChat AI is more than an app. It is your shortcut to a more informed, more creative and more interactive day.\n\nDownload Chat AI and have a proper look at what it can do.\n\nPrivacy Policy: https://static.askaichat.app/privacy-en.html\nTerms & Conditions: https://static.askaichat.app/terms-conditions-en.html","averageUserRating":4.67612,"trackCensoredName":"Chat AI: Ask Agent Anything","trackViewUrl":"https://apps.apple.com/no/app/chat-ai-ask-agent-anything/id1668787639?uo=4","contentAdvisoryRating":"12+","averageUserRatingForCurrentVersion":4.67612,"languageCodesISO2A":["AR","EN","FR","DE","ID","IT","JA","KO","PT","RO","RU","ZH","ES","TR","VI"],"fileSizeBytes":"200597504