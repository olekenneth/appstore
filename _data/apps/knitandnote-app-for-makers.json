png/60x60bb.jpg","artworkUrl100":"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/af/a7/66/afa76666-e5d6-1704-37c6-5fa16d3705d7/AppIcon-0-0-1x_U007epad-0-1-85-220.png/100x100bb.jpg","averageUserRatingForCurrentVersion":4.57964,"languageCodesISO2A":["EN","NB"],"fileSizeBytes":"112604160","formattedPrice":"Free","userRatingCountForCurrentVersion":609,"trackContentRating":"4+","minimumOsVersion":"16.4","artistId":1634163610,"artistName":"Knitandnote AS","genres":["Lifestyle","Utilities"],"price":0.0,"bundleId":"com.ios.knitandnote","primaryGenreName":"Lifestyle","primaryGenreId":6012,"genreIds":["6012","6002"],"sellerName":"Knitandnote AS","isVppDeviceBasedLicensingEnabled":true,"trackId":1634163608,"trackName":"Knitandnote: Knitting App","releaseDate":"2023-01-19T08:00:00Z","currentVersionReleaseDate":"2026-08-24T08:35:32Z","releaseNotes":"Open patterns straight from other apps — share a PDF or pictures to Knit&Note and they land in your pattern library\nChanges you make on one device now show up faster on your other devices\nFaster loading of projects and the shop\nVarious bug fixes and performance improvement","version":"2.0.6","wrapperType":"software","currency":"NOK","description":"Everything you need for your knitting in one place.\n\nBring out your creative potential with Knit&Note – an app designed to make your knitting and crochet journey as easy, inspiring and enjoyable as possible. We're here to simplify every aspect of your crafting, allowing you to focus on unleashing your creativity and create beautiful, handmade items.\n\n\n\nKey Features:\n- Organize your projects effortlessly with detailed pages for patterns, yarn details, and more.\n- Experience an expansive pattern library and dive into a wide range of high-quality knitting and crochet patterns, presented in a convenient and intuitive style, similar to popular streaming services. Ideal for crafters at any skill level.\n- Buy the yarn and stash you need for your projects in our in-app yarn shop, and get it delivered to your doorstep\n- Enhance your knitting with tools that helps you progress. Multi-functional pattern-viewer, featuring color highlighters, integrated row counters, increase/ decrease calculator, yarn calculator, ruler, video tutorials and more.\n- Stay motivated and keep track of your progress with fun statistics that showcase your crafting achievements and growth.\n- Efficient Yarn & Needle Inventory: Keep track of your crafting materials with ease, ensuring you're always prepared for your next project.\n-Social Community where you can share, inspire, and connect with fellow crafters in a supportive and creative environment.\n- Eco-Conscious Crafting: Embrace sustainability with our eco-friendly app, powered by 100% renewable energy.\n\n\nKnit&Note isn't just an app; it's a catalyst for your creativity. It's designed to remove the hurdles in your crafting journey, leaving you free to explore, create, and share in a more organized, sustainable, and enjoyable way.\n\nTerms of Use (EULA): https://www.apple.com/legal/internet-services/itunes/dev/stdeula/","contentAdvisoryRating":"4+","trackCensoredName":"Knitandnote: Knitting App","trackViewUrl":"https://apps.apple.com/no/app/knitandnote-knitting-app/id1634163608?uo=4","averageUserRating":4.57964,"userRatingCount":609}